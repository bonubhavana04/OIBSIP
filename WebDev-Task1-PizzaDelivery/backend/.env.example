# ── Admin seed (used only by: node seedAdmin.js) ─────────────────────────────
# Set these before running seed:admin, then remove or rotate them.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
ADMIN_NAME=Admin

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Option A — Local MongoDB (must have MongoDB Community Server installed & running)
#   Download: https://www.mongodb.com/try/download/community
MONGO_URI=mongodb://localhost:27017/pizza_delivery

# Option B — MongoDB Atlas (free tier, no local install needed)
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Add your IP to the Network Access allowlist
#   3. Create a database user and paste the connection string below
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pizza_delivery?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── Razorpay (test mode) ──────────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* keys for development — never commit live keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# Webhook secret: Dashboard → Settings → Webhooks → Add New Webhook → Secret field
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# ── Nodemailer / Gmail SMTP ───────────────────────────────────────────────────
# Use a Gmail App Password (NOT your real password):
#   https://myaccount.google.com/apppasswords
# Leave EMAIL_USER blank to disable email sending (orders still work)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
