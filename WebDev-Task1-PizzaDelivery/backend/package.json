    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14"
