{
  "name": "pizza-delivery-backend",
  "version": "1.0.0",
  "description": "Pizza Delivery REST API — Node.js, Express, MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node seedAdmin.js",
    "seed:menu": "node seedMenu.js",
    "seed:inventory": "node seedInventory.js",
    "seed:all": "node seedAdmin.js && node seedMenu.js && node seedInventory.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch"
  },
  "keywords": [
    "pizza",
